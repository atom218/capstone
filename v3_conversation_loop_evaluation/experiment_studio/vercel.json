{
  "cleanUrls": false,
  "functions": {
    "api/chat.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/experiment-studio.html" }
  ]
}
