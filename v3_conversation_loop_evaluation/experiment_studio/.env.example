# Experiment Studio: local Azure OpenAI settings.
# 1. Copy this file to .env in the same folder:   cp .env.example .env
# 2. Paste the team's key below (get it from the shared password vault, never from chat or email).
# 3. Start the dashboard with "Start Experiment Studio.command" or python3 run_studio.py.
# .env is git-ignored, so it stays on your computer. Never commit it.

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://way5959-openai.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview
